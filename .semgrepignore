# Semgrep ignore list — false-positive suppressions for parkhub-php.
#
# These are NOT security exceptions; they are rule-specific false positives
# where Semgrep's built-in rule packs (p/javascript, p/typescript, p/php,
# p/laravel) misinterpret legitimate non-security code as vulnerabilities.

# i18n locale dictionaries — large compressed translation blobs that trip
# string-similarity / hardcoded-secret heuristics. No real secrets here.
resources/js/src/i18n/locales/
parkhub-web/src/i18n/locales/

# React DOM keys / non-cryptographic Math.random() use — UI-only entropy
# for stable list keys, never for tokens or session IDs.
resources/js/src/components/
parkhub-web/src/components/

# Test fixtures + e2e specs — test-only code, not shipped, separate threat
# model. Real production code lives outside these paths.
tests/
parkhub-web/tests/
parkhub-web/e2e/
resources/js/src/**/*.test.tsx
parkhub-web/src/**/*.test.tsx

# Generated artefacts — build outputs, never source-of-truth.
parkhub-web/storybook-static/
parkhub-web/dist/
.lost-pixel/
.unlighthouse/
_accessibility-reports/

# Vendor / dependencies (gitignored, but kept here for completeness).
vendor/
node_modules/
